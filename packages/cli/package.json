{
  "name": "@genocode/cli",
  "version": "0.3.0",
  "description": "The genie command line: check, format, render, mutate, breed and morph.",
  "keywords": [
    "genocode",
    "creatures",
    "generative art",
    "cli",
    "genie"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genocode-org/GenoCode-cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/genocode-org/GenoCode-cli#readme",
  "bugs": "https://github.com/genocode-org/GenoCode-cli/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@genocode/core": "0.11.0",
    "@genocode/render": "0.12.0"
  },
  "bin": {
    "genie": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
